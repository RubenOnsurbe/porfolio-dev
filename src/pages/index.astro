	<script>
		// Counter animation for stats
		document.querySelectorAll("[data-count]").forEach((el) => {
			const target = parseInt(
				(el as HTMLElement).dataset.count ?? "0",
				10,
			);
			let current = 0;
			const step = Math.ceil(target / 40);
			const tick = () => {
				current = Math.min(current + step, target);
				(el as HTMLElement).textContent =
					current + (target >= 10 ? "+" : "+");
				if (current < target) setTimeout(tick, 35);
			};
			setTimeout(tick, 800);
		});
		// Typing effect for hero paragraph
		const el = document.getElementById("hero-typed");
		if (el) {
			const full = el.textContent ?? "";
			el.textContent = "";
			el.classList.add("type-cursor");
			let i = 0;
			const type = () => {
				if (i < full.length) {
					el.textContent += full[i++];
					setTimeout(type, 28 + Math.random() * 18);
				} else {
					setTimeout(() => el.classList.remove("type-cursor"), 1200);
				}
			};
			setTimeout(type, 600);
		}
	</script>
